# ---------------------------------------------------------------------------
# voeq-registry — environment template. Copy to .env and fill in.
# NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 16) ---
# Local dev, Neon, or any Postgres 16+. The registry has its OWN database,
# separate from the marketplace (ADR-001).
DATABASE_URL="postgresql://user:password@localhost:5432/voeq_registry?schema=public"

# --- Staff admin auth: Google OAuth ONLY (doc 07 §4.7) ---
# No staff passwords exist. Identity = a verified Google email on the
# institution's allowlist. Create credentials at console.cloud.google.com,
# authorised redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""              # openssl rand -base64 32
APP_URL="http://localhost:3000"

# --- Staff allowlists: the two admin families (doc 07 §4.6) ---
# An email may appear on ONE list only — never both. Platform = Voeq-side
# (website, institutions, fee schedule, role grants). Register = Media Unit
# (review, corrections, fee ledger). First Google sign-in creates the account.
STAFF_ALLOWLIST_PLATFORM=""
STAFF_ALLOWLIST_REGISTER=""

# --- Email: Resend (every state change emails the applicant) ---
RESEND_API_KEY=""
EMAIL_FROM="NMU Business Register <register@voeq.ng>"

# --- Object storage: Cloudflare R2 (private bucket, originals) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="voeq-registry-private"
R2_PUBLIC_URL=""            # not used for originals; display derivatives live on Cloudinary

# --- Public imagery (approved entries only) — existing voeq.ng account ---
CLOUDINARY_CLOUD_NAME="jq9gwigz"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Bank feed (Phase 2) ---
BANK_ALERT_INBOX=""         # dedicated inbox bank alerts are forwarded to
